# Copy to .env. Never commit .env or any key file.

# Claude, for draft extraction only.
ANTHROPIC_API_KEY=

# Google Earth Engine service account: path to a key file kept outside the repo.
EARTHENGINE_SERVICE_ACCOUNT_FILE=

# Public HTTPS address of the tunnel that points at the capture listener only.
CAPTURE_PUBLIC_URL=

# Local storage.
DATABASE_PATH=./data/site-data.db
UPLOAD_DIR=./uploads
