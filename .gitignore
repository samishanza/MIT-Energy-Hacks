# Isolated worktrees (git worktree / ce-worktree, and Claude Code)
.worktrees/
.claude/worktrees/

# Machine-local settings
.claude/settings.local.json
.compound-engineering/*.local.yaml

# Compound Engineering scratch space
.context/compound-engineering/

# Dependencies and build output
node_modules/
dist/

# Secrets. Keep credentials out of Git, including service account key files.
.env
.env.*
!.env.example
*service-account*.json
*-key.json

# Local databases and uploaded evidence
*.db
*.db-shm
*.db-wal
*.sqlite
uploads/

# Plan-set drawings aligned onto the map (customer documents)
apps/web/public/private/

# Ground truth read off customer plan sets
private/
