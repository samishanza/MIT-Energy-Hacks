# Copy to .env. Never commit .env or any key file.

# Claude: draft extraction from uploads, and the site review agent.
ANTHROPIC_API_KEY=

# Google Earth Engine service account: path to a key file kept outside the repo.
EARTHENGINE_SERVICE_ACCOUNT_FILE=
EARTHENGINE_PROJECT=

# Public HTTPS address of the tunnel that points at the capture listener only.
CAPTURE_PUBLIC_URL=

# Local storage.
DATABASE_PATH=./data/site-data.db
UPLOAD_DIR=./uploads
# Optional: Supabase as the system of record (apps/api/supabase/schema.sql). The secret key never goes in the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
